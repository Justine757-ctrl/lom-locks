---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = [
  { name: 'Tous les articles', slug: '/blog' },
  { name: "Conseils d'entretien", slug: '/blog/categorie/conseils-entretien' },
  { name: 'Soins naturels', slug: '/blog/categorie/soins-naturels' },
  { name: 'Routine de nuit', slug: '/blog/categorie/routine-de-nuit' },
  { name: 'FAQ', slug: '/blog/categorie/faq' },
];
---

<Layout
  title="Blog & Conseils Locks — LoméLocks (Soin Capillaire Togo)"
  description="Guides pratiques et astuces pour entretenir vos locks à Lomé : hydratation légère, routine de nuit au satin, bain détox et erreurs à éviter au départ."
>
  
  <section class="py-12 sm:py-16 bg-gradient-to-b from-fond via-fond-creme/40 to-fond border-b border-chocolat-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-3">
        Conseils &amp; Soins Naturels
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-chocolat-950">
        Le Blog de LoméLocks
      </h1>
      <p class="text-base sm:text-lg text-chocolat-700 mt-4 leading-relaxed">
        Des articles rédigés avec passion pour chouchouter vos locks sous le climat togolais. Conseils d'hydratation, méthodes douces et rituels protecteurs.
      </p>

      <!-- Liens Catégories -->
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {categories.map((cat, idx) => (
          <a
            href={cat.slug}
            class={`px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all border ${
              idx === 0
                ? 'bg-chocolat text-fond border-chocolat shadow-sm'
                : 'bg-white text-chocolat-800 border-chocolat-200 hover:border-dore hover:text-chocolat-950'
            }`}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-fond">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            slug={post.slug}
            date={post.data.date}
            category={post.data.category}
            cover={post.data.cover}
            excerpt={post.data.excerpt}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>

      <!-- Flux RSS invitation -->
      <div class="mt-16 text-center text-xs text-chocolat-600 flex items-center justify-center gap-2">
        <span>Abonnez-vous à notre</span>
        <a href="/rss.xml" class="text-dore-700 font-bold hover:underline flex items-center gap-1">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          Flux RSS
        </a>
      </div>

    </div>
  </section>

</Layout>
