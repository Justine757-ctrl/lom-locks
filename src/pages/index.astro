---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogCard from '../components/BlogCard.astro';
import servicesData from '../data/services.json';
import config from '../data/config.json';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const sortedPosts = allBlogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const recentPosts = sortedPosts.slice(0, 3);
const previewServices = servicesData.services.slice(0, 4);
---

<Layout
  title="LoméLocks — Vos locks, sublimées au naturel à Lomé"
  description="Service haut de gamme de coiffure et soin de locks à domicile à Lomé (Togo). Départ, retwist, locks métissés, faux locks. Réservez sur WhatsApp."
>
  
  <!-- HERO BANNER -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-gradient-to-b from-fond via-fond-creme/50 to-fond py-12 lg:py-20">
    <!-- Motifs décoratifs d'arrière-plan -->
    <div class="absolute inset-0 bg-motif-dore opacity-40 pointer-events-none"></div>
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-dore/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-chocolat-300/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Colonne Texte -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
          
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-chocolat-100/90 border border-dore/40 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-dore animate-pulse"></span>
            <span class="text-xs font-semibold text-chocolat-900 tracking-wide">
              {config.parentBrandMention} • Lomé, Togo
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-chocolat-950 leading-[1.15] tracking-tight">
            Vos locks, <br class="hidden sm:inline" />
            <span class="gold-gradient-text italic font-serif">sublimées au naturel.</span>
          </h1>

          <p class="text-base sm:text-lg text-chocolat-800/90 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
            Départ de locks, retwist soigné, locks métissés et coiffures d'exception directement <strong>à votre domicile partout à Lomé</strong> ou chez votre spécialiste. Des soins 100% naturels pour préserver vos racines.
          </p>

          <!-- Boutons d'appel à l'action -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a
              href={`https://wa.me/${config.whatsappNumber}?text=Bonjour%20Lom%C3%A9Locks%2C%20je%20souhaiterais%20r%C3%A9server%20une%20prestation.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-base text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-600 shadow-dore hover:shadow-dore-lg hover:brightness-105 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.772.813 2.791.814 3.179 0 5.766-2.587 5.767-5.766.002-3.181-2.584-5.766-5.767-5.766zm3.374 8.167c-.145.407-.745.748-1.026.795-.275.045-.632.067-1.032-.061-.258-.083-.585-.192-.999-.371-1.745-.757-2.879-2.529-2.967-2.646-.087-.117-.714-.949-.714-1.811 0-.862.451-1.286.611-1.46.16-.174.349-.218.465-.218.116 0 .233.001.334.006.107.005.25-.041.391.298.145.349.494 1.206.538 1.293.044.087.073.189.015.305-.058.117-.087.189-.174.291-.087.102-.184.227-.263.305-.088.087-.18.182-.077.359.102.174.453.748.972 1.211.668.595 1.232.78 1.406.867.175.087.276.073.378-.044.102-.116.437-.509.553-.683.117-.175.233-.146.393-.088.16.058 1.018.48 1.193.567.175.088.291.131.334.204.044.073.044.422-.101.829z"/>
              </svg>
              <span>Réserver sur WhatsApp</span>
            </a>

            <a
              href="/prestations"
              class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-2xl font-semibold text-sm text-chocolat-900 bg-white hover:bg-chocolat-50 border border-chocolat-200 shadow-sm transition-all"
            >
              Voir les tarifs
            </a>
          </div>

          <!-- Éléments de rassurance / confiance -->
          <div class="pt-6 border-t border-chocolat-200/60 grid grid-cols-3 gap-4 text-center sm:text-left">
            <div>
              <span class="block text-xl sm:text-2xl font-serif font-black text-chocolat-900">100%</span>
              <span class="text-xs text-chocolat-600 font-medium">Soins naturels</span>
            </div>
            <div>
              <span class="block text-xl sm:text-2xl font-serif font-black text-chocolat-900">Tout Lomé</span>
              <span class="text-xs text-chocolat-600 font-medium">À domicile</span>
            </div>
            <div>
              <span class="block text-xl sm:text-2xl font-serif font-black text-chocolat-900">2 000 F</span>
              <span class="text-xs text-chocolat-600 font-medium">Retwist dès</span>
            </div>
          </div>

        </div>

        <!-- Colonne Image Réelle Média -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-sm sm:max-w-md lg:max-w-none">
            
            <!-- Décoratif arrière plan -->
            <div class="absolute -inset-3 rounded-[2.5rem] bg-gradient-to-tr from-dore via-chocolat-400 to-dore-200 opacity-30 blur-lg"></div>
            
            <!-- Carte photo principale -->
            <div class="relative rounded-[2rem] overflow-hidden shadow-2xl border-2 border-white/80 bg-chocolat-950 aspect-[3/4]">
              <img
                src="/media/locks-curly-1.jpg"
                alt="Création de locks métissées curly bicolores noir et cuivre réalisée à Lomé par Justine"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />

              <!-- Badge incrusté sur la photo -->
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-chocolat-950/80 backdrop-blur-md border border-dore/40 text-fond">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-dore">Réalisation LoméLocks</span>
                    <h3 class="text-sm font-bold text-white">Locks Métissés Curly Bicolores</h3>
                  </div>
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-dore text-chocolat-950">
                    Lomé
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PRÉSENTATION RAPIDE : POURQUOI CHOISIR LOMÉLOCKS -->
  <section class="py-16 bg-white border-y border-chocolat-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200">
          L'Excellence à Domicile
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-chocolat-950">
          L'Art des Locks chez Vous, en Toute Sérénité
        </h2>
        <p class="text-base text-chocolat-700 leading-relaxed">
          Finis les longues attentes au salon. Justine se déplace avec son matériel professionnel directement chez vous à Lomé pour prendre soin de votre couronne avec patience, écoute et bienveillance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-8 rounded-3xl bg-fond border border-chocolat-100 shadow-carte hover:shadow-doux transition-all">
          <div class="w-14 h-14 rounded-2xl bg-chocolat-100 text-chocolat-800 flex items-center justify-center mb-6 text-2xl border border-dore/40">
            🌿
          </div>
          <h3 class="text-xl font-serif font-bold text-chocolat-950 mb-3">
            Soin 100% Naturel
          </h3>
          <p class="text-sm text-chocolat-700 leading-relaxed">
            Aucune cire lourde ni produit chimique agressif qui étouffe la tige. Nous utilisons uniquement des eaux florales, de l'aloe vera et des huiles végétales légères pour des locks saines qui respirent.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-fond border border-chocolat-100 shadow-carte hover:shadow-doux transition-all">
          <div class="w-14 h-14 rounded-2xl bg-chocolat-100 text-chocolat-800 flex items-center justify-center mb-6 text-2xl border border-dore/40">
            🏡
          </div>
          <h3 class="text-xl font-serif font-bold text-chocolat-950 mb-3">
            Confort à Domicile
          </h3>
          <p class="text-sm text-chocolat-700 leading-relaxed">
            Intervention chez vous partout dans Lomé (ou chez la prestataire). Départs de préférence très tôt le matin pour vous permettre d'attaquer votre journée dans un confort absolu.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-fond border border-chocolat-100 shadow-carte hover:shadow-doux transition-all">
          <div class="w-14 h-14 rounded-2xl bg-chocolat-100 text-chocolat-800 flex items-center justify-center mb-6 text-2xl border border-dore/40">
            ✨
          </div>
          <h3 class="text-xl font-serif font-bold text-chocolat-950 mb-3">
            Finitions Impeccables
          </h3>
          <p class="text-sm text-chocolat-700 leading-relaxed">
            Tracés symétriques précis, resserrage régulier et confection minutieuse à la main pour un résultat qui valorise votre morphologie et dure dans le temps.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- APERÇU DES PRESTATIONS & PRIX -->
  <section class="py-16 sm:py-20 bg-fond">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-2">
            Tarifs Transparents
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-chocolat-950">
            Nos Prestations Vedettes
          </h2>
          <p class="text-sm text-chocolat-700 mt-2">
            Prix de base indicatifs. Le tarif final dépend de la longueur et de la quantité, et est confirmé sur WhatsApp.
          </p>
        </div>

        <a
          href="/prestations"
          class="inline-flex items-center gap-2 text-sm font-bold text-chocolat-900 hover:text-dore-700 transition-colors"
        >
          <span>Voir toutes les 8 prestations &amp; estimateur</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {previewServices.map((srv) => (
          <ServiceCard
            id={srv.id}
            name={srv.name}
            priceDisplay={srv.priceDisplay}
            isQuote={srv.isQuote}
            duration={srv.duration}
            popular={srv.popular}
            category={srv.category}
            shortDescription={srv.shortDescription}
          />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/prestations#estimateur"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-chocolat-900 text-dore-200 text-xs sm:text-sm font-bold border border-dore/40 hover:bg-chocolat-950 shadow-md transition-all"
        >
          <span>🧮 Utiliser notre estimateur de tarif en ligne</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- APERÇU DE LA GALERIE -->
  <section class="py-16 sm:py-20 bg-white border-t border-chocolat-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-2">
          Portfolio Créations
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-chocolat-950">
          Aperçu de Nos Réalisations
        </h2>
        <p class="text-sm text-chocolat-700 mt-2">
          Découvrez la qualité de nos départs, retwists et locks métissés réalisés à Lomé.
        </p>
      </div>

      <GalleryGrid limit={3} showFilters={false} />

      <div class="mt-10 text-center">
        <a
          href="/galerie"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-fond border border-chocolat-200 text-chocolat-900 text-sm font-bold hover:bg-chocolat-100 transition-colors shadow-sm"
        >
          <span>Voir la galerie complète et filtrer par style</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- TÉMOIGNAGES -->
  <Testimonials limit={3} />

  <!-- DERNIERS ARTICLES DU BLOG -->
  <section class="py-16 sm:py-20 bg-fond border-t border-chocolat-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-2">
            Conseils d'Expert
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-chocolat-950">
            Le Blog des Locks Saines
          </h2>
          <p class="text-sm text-chocolat-700 mt-2">
            Astuces, hydratation, routine de nuit et détox adaptées au climat de Lomé.
          </p>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-bold text-chocolat-900 hover:text-dore-700 transition-colors"
        >
          <span>Tous nos articles</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            slug={post.slug}
            date={post.data.date}
            category={post.data.category}
            cover={post.data.cover}
            excerpt={post.data.excerpt}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- APPEL À L'ACTION FINAL -->
  <section class="py-16 sm:py-24 bg-gradient-to-br from-chocolat-900 via-chocolat to-chocolat-950 text-fond relative overflow-hidden">
    <div class="absolute inset-0 bg-motif-dore opacity-20 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-dore-300 bg-dore-900/60 border border-dore/40">
        Prise de Rendez-vous Rapide
      </span>

      <h2 class="text-3xl sm:text-5xl font-serif font-extrabold text-fond leading-tight">
        Prête à Réserver Votre Séance de Locks à Lomé ?
      </h2>

      <p class="text-base sm:text-lg text-chocolat-200 max-w-2xl mx-auto leading-relaxed">
        Partagez-nous vos envies, votre longueur et votre quartier. Nous confirmons votre tarif exact et bloquons votre créneau en quelques minutes sur WhatsApp.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`https://wa.me/${config.whatsappNumber}?text=Bonjour%20Lom%C3%A9Locks%2C%20je%20souhaiterais%20r%C3%A9server%20une%20prestation.`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-base text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-600 shadow-dore hover:shadow-dore-lg hover:brightness-105 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.772.813 2.791.814 3.179 0 5.766-2.587 5.767-5.766.002-3.181-2.584-5.766-5.767-5.766zm3.374 8.167c-.145.407-.745.748-1.026.795-.275.045-.632.067-1.032-.061-.258-.083-.585-.192-.999-.371-1.745-.757-2.879-2.529-2.967-2.646-.087-.117-.714-.949-.714-1.811 0-.862.451-1.286.611-1.46.16-.174.349-.218.465-.218.116 0 .233.001.334.006.107.005.25-.041.391.298.145.349.494 1.206.538 1.293.044.087.073.189.015.305-.058.117-.087.189-.174.291-.087.102-.184.227-.263.305-.088.087-.18.182-.077.359.102.174.453.748.972 1.211.668.595 1.232.78 1.406.867.175.087.276.073.378-.044.102-.116.437-.509.553-.683.117-.175.233-.146.393-.088.16.058 1.018.48 1.193.567.175.088.291.131.334.204.044.073.044.422-.101.829z"/>
          </svg>
          <span>Écrire sur WhatsApp (+228 91 29 59 50)</span>
        </a>

        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl font-bold text-sm text-fond bg-chocolat-800/80 hover:bg-chocolat-800 border border-chocolat-600 transition-all"
        >
          Formulaire de demande en ligne
        </a>
      </div>

      <p class="text-xs text-chocolat-400 pt-2">
        Acompte de 50 % demandé 4 jours avant • Déplacement dans tout Lomé
      </p>

    </div>
  </section>

</Layout>
