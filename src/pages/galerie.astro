---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import config from '../data/config.json';
---

<Layout
  title="Galerie Réalisations — LoméLocks (Créations de Locks à Lomé)"
  description="Découvrez nos photos de locks métissés, retwists, départs et coiffures réalisés à Lomé. Filtrez par style et réservez votre modèle."
>
  
  <section class="py-12 sm:py-16 bg-gradient-to-b from-fond via-fond-creme/40 to-fond border-b border-chocolat-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-3">
        Portfolio Coiffure
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-chocolat-950">
        Galerie de Nos Réalisations
      </h1>
      <p class="text-base sm:text-lg text-chocolat-700 mt-4 leading-relaxed">
        Explorez nos créations de locks à Lomé. Cliquez sur les filtres pour découvrir nos différents styles : locks métissés curly, départs harmonieux, retwists soignés et faux locks.
      </p>
    </div>
  </section>

  <section class="py-16 bg-fond">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Grille interactive avec filtres -->
      <GalleryGrid showFilters={true} />

      <!-- Bannière d'inspiration -->
      <div class="mt-16 bg-white rounded-3xl p-8 sm:p-10 border border-chocolat-100 shadow-carte text-center max-w-3xl mx-auto">
        <h2 class="text-2xl font-serif font-bold text-chocolat-950 mb-3">
          Vous avez une photo d'inspiration en tête ?
        </h2>
        <p class="text-sm text-chocolat-700 leading-relaxed mb-6">
          Vous pouvez nous envoyer directement une photo ou une capture d'écran sur WhatsApp. Nous vous confirmerons la faisabilité, le temps nécessaire et le tarif sur mesure.
        </p>
        <a
          href={`https://wa.me/${config.whatsappNumber}?text=Bonjour%20Lom%C3%A9Locks%2C%20j%27ai%20une%20photo%20d%27inspiration%20que%20j%27aimerais%20vous%20montrer%20pour%20une%20coiffure.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-2xl font-bold text-sm text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-600 shadow-dore hover:shadow-dore-lg hover:brightness-105 transition-all"
        >
          <span>Envoyer mon modèle d'inspiration sur WhatsApp</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

</Layout>
