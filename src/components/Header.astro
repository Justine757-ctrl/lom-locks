---
import config from '../data/config.json';

const navItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Prestations & Tarifs', href: '/prestations' },
  { label: 'Galerie', href: '/galerie' },
  { label: 'Blog', href: '/blog' },
  { label: 'À propos', href: '/a-propos' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-chocolat-200/50 glass-nav shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo LoméLocks -->
      <a href="/" class="flex items-center gap-2 group focus:outline-none focus:ring-2 focus:ring-dore rounded-lg p-1" aria-label="Retour à l'accueil LoméLocks">
        <img src="/logo-dark.svg" alt="LoméLocks — Vos locks, sublimées au naturel" class="h-12 w-auto transition-transform duration-300 group-hover:scale-105" />
      </a>

      <!-- Navigation Desktop -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-3" aria-label="Navigation principale">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2 text-sm font-medium transition-colors duration-200 rounded-full ${
                isActive
                  ? 'text-chocolat bg-chocolat-100/80 font-semibold'
                  : 'text-chocolat-700 hover:text-chocolat hover:bg-chocolat-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Bouton Réserver Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/contact#formulaire"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-600 rounded-full shadow-dore hover:shadow-dore-lg hover:brightness-105 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Réserver
        </a>
      </div>

      <!-- Bouton Menu Burger Mobile -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={`https://wa.me/${config.whatsappNumber}?text=Bonjour%20Lom%C3%A9Locks%2C%20je%20souhaiterais%20r%C3%A9server%20une%20prestation.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-semibold text-chocolat-950 bg-dore rounded-full shadow-sm hover:brightness-105"
        >
          Réserver
        </a>

        <button
          id="menu-btn"
          type="button"
          class="p-2 rounded-lg text-chocolat hover:text-chocolat-900 hover:bg-chocolat-100 focus:outline-none focus:ring-2 focus:ring-dore"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Menu Mobile Déroulant -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-chocolat-200 bg-fond px-4 pt-3 pb-6 space-y-2 shadow-xl animate-fade-in">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-4 py-3 rounded-xl text-base font-medium transition-colors ${
            isActive
              ? 'bg-chocolat-100 text-chocolat font-bold'
              : 'text-chocolat-800 hover:bg-chocolat-50'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-chocolat-200/60 flex flex-col gap-3">
      <a
        href="/contact#formulaire"
        class="w-full text-center py-3 px-5 rounded-full font-semibold text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-600 shadow-dore"
      >
        Réserver une prestation
      </a>
      <a
        href={`https://wa.me/${config.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-3 px-5 rounded-full font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 flex items-center justify-center gap-2"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        WhatsApp direct : {config.phone}
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
