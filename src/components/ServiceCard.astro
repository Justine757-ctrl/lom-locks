---
import config from '../data/config.json';

interface Props {
  id: string;
  name: string;
  priceDisplay: string;
  isQuote: boolean;
  duration?: string;
  popular?: boolean;
  category?: string;
  shortDescription: string;
}

const {
  id,
  name,
  priceDisplay,
  isQuote,
  duration,
  popular = false,
  shortDescription
} = Astro.props;

const whatsappBookingText = encodeURIComponent(
  `Bonjour LoméLocks ! 🌿 Je souhaite réserver ou avoir des informations pour la prestation : ${name} (${priceDisplay}). Pouvez-vous me renseigner ? Merci !`
);
const whatsappUrl = `https://wa.me/${config.whatsappNumber}?text=${whatsappBookingText}`;
---

<div class={`relative flex flex-col justify-between bg-white rounded-3xl p-6 sm:p-7 transition-all duration-300 border ${
  popular 
    ? 'border-dore ring-2 ring-dore/30 shadow-dore' 
    : 'border-chocolat-100 hover:border-dore/60 shadow-carte hover:shadow-doux'
} hover:-translate-y-1`}>
  
  {popular && (
    <div class="absolute -top-3 right-6">
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-dore text-chocolat-950 shadow-sm">
        ★ Très Demandé
      </span>
    </div>
  )}

  <div>
    <!-- En-tête de la carte -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="text-xl font-serif font-bold text-chocolat-950 leading-snug">
        {name}
      </h3>
    </div>

    <!-- Prix et durée -->
    <div class="flex flex-wrap items-baseline gap-2 mb-4">
      <span class="text-xs text-chocolat-500 font-medium">À partir de</span>
      <span class="text-2xl font-serif font-black text-chocolat-900 text-dore-700">
        {priceDisplay}
      </span>
      {duration && (
        <span class="ml-auto inline-flex items-center text-xs font-medium text-chocolat-600 bg-fond-creme px-2.5 py-1 rounded-full border border-chocolat-200/50">
          ⏱ {duration}
        </span>
      )}
    </div>

    <!-- Description courte (2 phrases max) -->
    <p class="text-sm text-chocolat-700 leading-relaxed mb-6">
      {shortDescription}
    </p>
  </div>

  <!-- Actions -->
  <div class="pt-4 border-t border-chocolat-100/80 flex items-center gap-3">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs text-chocolat-950 bg-gradient-to-r from-dore-300 via-dore to-dore-500 shadow-sm hover:brightness-105 active:scale-95 transition-all"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.772.813 2.791.814 3.179 0 5.766-2.587 5.767-5.766.002-3.181-2.584-5.766-5.767-5.766zm3.374 8.167c-.145.407-.745.748-1.026.795-.275.045-.632.067-1.032-.061-.258-.083-.585-.192-.999-.371-1.745-.757-2.879-2.529-2.967-2.646-.087-.117-.714-.949-.714-1.811 0-.862.451-1.286.611-1.46.16-.174.349-.218.465-.218.116 0 .233.001.334.006.107.005.25-.041.391.298.145.349.494 1.206.538 1.293.044.087.073.189.015.305-.058.117-.087.189-.174.291-.087.102-.184.227-.263.305-.088.087-.18.182-.077.359.102.174.453.748.972 1.211.668.595 1.232.78 1.406.867.175.087.276.073.378-.044.102-.116.437-.509.553-.683.117-.175.233-.146.393-.088.16.058 1.018.48 1.193.567.175.088.291.131.334.204.044.073.044.422-.101.829z"/>
      </svg>
      Réserver sur WhatsApp
    </a>

    <a
      href={`/contact?prestation=${id}#formulaire`}
      class="px-3 py-2.5 rounded-xl text-xs font-semibold text-chocolat-800 hover:text-chocolat-950 bg-fond hover:bg-chocolat-100 border border-chocolat-200 transition-colors"
      title="Réserver via le formulaire"
    >
      Formulaire
    </a>
  </div>
</div>
