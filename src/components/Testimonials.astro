---
import testimonialsData from '../data/temoignages.json';

interface Props {
  limit?: number;
  showTitle?: boolean;
}

const { limit, showTitle = true } = Astro.props;
const displayTestimonials = limit ? testimonialsData.slice(0, limit) : testimonialsData;
---

<section class="py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {showTitle && (
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-dore-700 bg-dore-50 border border-dore-200 mb-3">
          Confiance &amp; Satisfaction
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-chocolat-950">
          Les Retours de Nos Clientes à Lomé
        </h2>
        <p class="text-sm sm:text-base text-chocolat-700 mt-3">
          La passion du cheveu naturel et l'attention portée à chaque séance font la réputation de LoméLocks.
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {displayTestimonials.map((t) => (
        <div class="flex flex-col justify-between bg-white rounded-3xl p-6 sm:p-8 shadow-carte border border-chocolat-100 hover:shadow-doux hover:border-dore/40 transition-all duration-300">
          <div>
            <!-- Étoiles dorées -->
            <div class="flex items-center gap-1 text-dore mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Avis textuel -->
            <p class="text-sm text-chocolat-800 italic leading-relaxed mb-6 font-serif">
              « {t.comment} »
            </p>
          </div>

          <!-- Auteur et infos -->
          <div class="pt-4 border-t border-chocolat-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-chocolat-100 text-chocolat-800 font-bold flex items-center justify-center text-xs border border-dore/40">
              {t.avatar}
            </div>
            <div>
              <h4 class="text-sm font-bold text-chocolat-950">
                {t.name}
              </h4>
              <p class="text-[11px] text-chocolat-500">
                {t.location} • <span class="text-dore-700 font-medium">{t.service}</span>
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
