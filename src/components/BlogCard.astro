---
interface Props {
  title: string;
  slug: string;
  date: string;
  category: string;
  cover: string;
  excerpt: string;
  readingTime?: string;
}

const {
  title,
  slug,
  date,
  category,
  cover,
  excerpt,
  readingTime = "5 min"
} = Astro.props;

// Formatage de la date en français (ex: 5 octobre 2024)
const parsedDate = new Date(date);
const formattedDate = parsedDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<article class="group flex flex-col bg-white rounded-3xl overflow-hidden shadow-carte border border-chocolat-100 hover:shadow-doux hover:border-dore/50 transition-all duration-300">
  
  <!-- Image de couverture -->
  <a href={`/blog/${slug}`} class="block relative aspect-[16/9] overflow-hidden bg-chocolat-900" aria-label={`Lire : ${title}`}>
    <img
      src={cover}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute top-4 left-4">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-chocolat-950/85 text-dore-200 backdrop-blur-md border border-dore/30">
        {category}
      </span>
    </div>
  </a>

  <!-- Contenu -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Date et temps de lecture -->
      <div class="flex items-center gap-3 text-xs text-chocolat-500 mb-3">
        <time datetime={date}>{formattedDate}</time>
        <span>•</span>
        <span>⏱ {readingTime} de lecture</span>
      </div>

      <!-- Titre de l'article -->
      <h3 class="font-serif font-bold text-xl text-chocolat-950 group-hover:text-dore-700 transition-colors leading-snug mb-3">
        <a href={`/blog/${slug}`}>
          {title}
        </a>
      </h3>

      <!-- Résumé -->
      <p class="text-sm text-chocolat-700 leading-relaxed line-clamp-3 mb-6">
        {excerpt}
      </p>
    </div>

    <!-- Lien de lecture -->
    <div class="pt-4 border-t border-chocolat-100 flex items-center justify-between">
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-2 text-xs font-bold text-chocolat-900 group-hover:text-dore-700 transition-colors"
      >
        <span>Lire l'article</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <span class="text-[11px] text-chocolat-400">LoméLocks Blog</span>
    </div>

  </div>
</article>
