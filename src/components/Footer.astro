---
import config from '../data/config.json';
---

<footer class="bg-chocolat-950 text-sable-100 pt-16 pb-12 border-t-2 border-dore/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-12 border-b border-chocolat-800/80">
      
      <!-- Colonne 1: Marque & Rattachement -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img src="/logo-light.svg" alt="LoméLocks" class="h-12 w-auto" />
        </a>
        <p class="text-dore-200 font-serif italic text-base">
          « {config.tagline} »
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-chocolat-900/90 border border-dore/40 text-xs font-semibold text-dore-300">
          <span class="w-2 h-2 rounded-full bg-dore"></span>
          {config.parentBrandMention}
        </div>
        <p class="text-xs text-chocolat-300 leading-relaxed">
          Service spécialisé de départ, entretien, retwist et coiffures de locks à domicile dans tout Lomé et chez la prestataire.
        </p>
      </div>

      <!-- Colonne 2: Liens Rapides -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-dore uppercase tracking-wider">Navigation</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-sable-200 hover:text-dore transition-colors">Accueil</a>
          </li>
          <li>
            <a href="/prestations" class="text-sable-200 hover:text-dore transition-colors">Prestations &amp; Tarifs</a>
          </li>
          <li>
            <a href="/prestations#estimateur" class="text-sable-200 hover:text-dore transition-colors">Estimateur de tarif</a>
          </li>
          <li>
            <a href="/galerie" class="text-sable-200 hover:text-dore transition-colors">Galerie réalisations</a>
          </li>
          <li>
            <a href="/blog" class="text-sable-200 hover:text-dore transition-colors">Blog Soins &amp; Conseils</a>
          </li>
          <li>
            <a href="/a-propos" class="text-sable-200 hover:text-dore transition-colors">À propos de Justine</a>
          </li>
          <li>
            <a href="/contact" class="text-sable-200 hover:text-dore transition-colors">Réservation &amp; Contact</a>
          </li>
        </ul>
      </div>

      <!-- Colonne 3: Modalités & Paiements Lomé -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-dore uppercase tracking-wider">Modalités &amp; Paiement</h3>
        <p class="text-xs text-sable-200 leading-relaxed">
          <strong class="text-dore-200">Acompte :</strong> 50 % à la réservation (4 jours avant la date pour confection des mèches/tiges).
        </p>
        <p class="text-xs text-sable-200 leading-relaxed">
          <strong class="text-dore-200">Déplacement :</strong> Partout à Lomé. Gratuit en zone standard, 2 000 FCFA au-delà.
        </p>
        <div class="pt-2">
          <span class="text-xs font-medium text-dore-300 block mb-1">Moyens de paiement acceptés :</span>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 rounded text-[11px] bg-chocolat-900 border border-chocolat-700 text-sable-100 font-mono">TMoney</span>
            <span class="px-2 py-0.5 rounded text-[11px] bg-chocolat-900 border border-chocolat-700 text-sable-100 font-mono">Flooz</span>
            <span class="px-2 py-0.5 rounded text-[11px] bg-chocolat-900 border border-chocolat-700 text-sable-100 font-mono">Espèces</span>
          </div>
        </div>
      </div>

      <!-- Colonne 4: Contact & Horaires -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-dore uppercase tracking-wider">Contact &amp; Créneaux</h3>
        <p class="text-xs text-sable-200">
          📍 <strong class="text-sable-100">Lieu :</strong> Lomé, Togo (à domicile ou chez la prestataire)
        </p>
        <p class="text-xs text-sable-200">
          🕒 <strong class="text-sable-100">Horaires :</strong> 06h00 – 19h00 (départs très tôt le matin de préférence, plus de créneaux le week-end)
        </p>
        <div class="pt-2">
          <a
            href={`https://wa.me/${config.whatsappNumber}?text=Bonjour%20Lom%C3%A9Locks%2C%20je%20souhaiterais%20des%20renseignements.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-700/80 hover:bg-emerald-600 text-white text-xs font-semibold shadow transition-all duration-200"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.772.813 2.791.814 3.179 0 5.766-2.587 5.767-5.766.002-3.181-2.584-5.766-5.767-5.766zm3.374 8.167c-.145.407-.745.748-1.026.795-.275.045-.632.067-1.032-.061-.258-.083-.585-.192-.999-.371-1.745-.757-2.879-2.529-2.967-2.646-.087-.117-.714-.949-.714-1.811 0-.862.451-1.286.611-1.46.16-.174.349-.218.465-.218.116 0 .233.001.334.006.107.005.25-.041.391.298.145.349.494 1.206.538 1.293.044.087.073.189.015.305-.058.117-.087.189-.174.291-.087.102-.184.227-.263.305-.088.087-.18.182-.077.359.102.174.453.748.972 1.211.668.595 1.232.78 1.406.867.175.087.276.073.378-.044.102-.116.437-.509.553-.683.117-.175.233-.146.393-.088.16.058 1.018.48 1.193.567.175.088.291.131.334.204.044.073.044.422-.101.829z"/>
            </svg>
            WhatsApp : +228 91 29 59 50
          </a>
        </div>
      </div>

    </div>

    <!-- Pied de page bas : Copyright et mentions -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-chocolat-400 gap-4">
      <p>
        &copy; {new Date().getFullYear()} LoméLocks. Tous droits réservés. {config.parentBrandMention}.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/mentions-legales" class="hover:text-dore transition-colors">Mentions légales</a>
        <span>•</span>
        <a href="/politique-de-confidentialite" class="hover:text-dore transition-colors">Politique de confidentialité</a>
        <span>•</span>
        <a href="/rss.xml" class="hover:text-dore transition-colors flex items-center gap-1">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          Flux RSS
        </a>
      </div>
    </div>
  </div>
</footer>
